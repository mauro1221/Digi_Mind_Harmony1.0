  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "1. Grilled Chicken Salad with Avocado\n\n\n\n\n\n\n\n\nIngredients:\n4
    oz (113g) grilled chicken breast\n1 cup mixed greens (e.g., spinach, arugula,
    romaine)\n1/2 avocado, sliced\n1/4 cup cherry tomatoes, halved\n1/4 cucumber,
    sliced\n1 tablespoon olive oil\n1 tablespoon balsamic vinegar\nSalt and pepper
    to taste\nOptional: A sprinkle of sunflower seeds or feta cheese\n\n\nInstructions:\nGrill
    the chicken breast until cooked through and no longer pink in the center. Let
    it rest for a couple of minutes before slicing it.\nIn a large bowl, combine
    mixed greens, cherry tomatoes, cucumber, and avocado slices.\nDrizzle olive oil
    and balsamic vinegar over the salad, tossing gently.\nAdd the grilled chicken
    on top, and season with salt and pepper.\nOptional: Top with sunflower seeds
    or a small sprinkle of feta cheese for extra crunch and flavor.\n\n\nCalories:\nGrilled
    Chicken (4 oz) - ~180 calories\nAvocado (1/2) - ~120 calories\nOlive oil (1 tbsp)
    - ~120 calories\nMixed greens and vegetables - ~30 calories\nBalsamic vinegar
    (1 tbsp) - ~10 calories\nTotal calories: ~460\n\n\n\n\n\n2. Quinoa and Roasted
    Vegetable Bowl\n\n\nIngredients:\n1/2 cup quinoa (uncooked)\n1/2 cup bell peppers,
    diced\n1/2 cup zucchini, diced\n1/2 cup cherry tomatoes, halved\n1 tablespoon
    olive oil\n1 teaspoon cumin\n1/2 teaspoon paprika\nSalt and pepper to taste\nFresh
    cilantro for garnish (optional)\n\n\nInstructions:\nPreheat your oven to 400\xB0F
    (200\xB0C). Line a baking sheet with parchment paper.\nToss the bell peppers,
    zucchini, and cherry tomatoes with olive oil, cumin, paprika, salt, and pepper.
    Spread evenly on the baking sheet.\nRoast the vegetables in the oven for about
    20-25 minutes, until they are tender and slightly charred.\nMeanwhile, cook quinoa
    according to package instructions (usually 1 part quinoa to 2 parts water, simmer
    for 15 minutes).\nOnce the quinoa and vegetables are ready, serve the quinoa
    as the base and top with the roasted vegetables.\nGarnish with fresh cilantro
    if desired.\n\n\nCalories:\nQuinoa (1/2 cup uncooked) - ~110 calories\nOlive
    oil (1 tbsp) - ~120 calories\nRoasted vegetables - ~80 calories\nCilantro (optional)
    - negligible\nTotal calories: ~310"
