--- !u!114 &602613377
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 602613375}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Bread soup</b>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<b>Ingredients:</b>\n\n-
    130 g rye bread\n- 400 ml water\n- 55 g sugar\n- 65 g cranberries (for juice)\n-
    3\u20134 g potato starch (about 1 tsp)\n- 65 g heavy cream (for whipping)\n-
    cinnamon, to taste\n- optional \u2013 dried apples, plums, raisins (or other
    dried fruits, e.g., figs, dates)\n\n<b>Preparation:</b>\n\n1. Lightly toast the
    rye bread slices in the oven.\n\n2. Place the toasted bread in a bowl, pour over
    boiling water, cover, and let sit for about 30 minutes.\n\n3. Remove the bread
    from the water, drain the excess liquid, and press it through a sieve into a
    pot with heated water.\n\n4. Add sugar, rinsed dried apples, plums, raisins (optionally
    figs or dates), cinnamon, and cranberry juice. Cook until the fruits are soft.
    If you prefer a thicker consistency, dissolve the potato starch in a little cold
    water, add to the soup, and bring it to a boil again.\n\n5. Let the soup cool.\n\n6.
    Serve with whipped cream.\L"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
