  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Fiery Sauerkraut Stew( Feuriger Sauerkraut Eintopf ) </b>\n\n(servings
    for 2 people)\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<b>Ingredients:</b>\n\n-
    2 medium-sized potatoes\n- 1 onion\n- 1 clove of garlic\n- 250g sauerkraut\n-
    2 tbsp olive oil\n- 1 liter vegetable broth\n- salt and pepper\n- 2 tbsp of tomato
    paste\n- 1 tbsp of dried italian herbs\n- 1 tbsp of sweet paprika\n- optionally
    hot paprika\n- 2 red bell peppers, chopped\n- 1 can of kidney beans or chickpeas\n-
    tabasco, chili peppers, or Pul Biber\n- optionally cr\xE8me fra\xEEche or sour
    cream\n\n<b>Instructions:</b>\n\n1. Peel and dice the potatoes, finely slice
    the onions and finely slice or press the garlic.\n\n2. Place the sauerkraut in
    a sieve and rinse under running water so the stew doesn't become too sour.\n\n3.
    Heat the oil in a large pot and cook the onions until soft\n\n4. After about
    2 minutes, add the garlic and continue cooking. Then add the diced potatoes,
    and sauerkraut and pour in the vegetable stock.\n\n5. Season the stock with salt,
    pepper, tomato paste, italian herbs, and paprika, and simmer for about 15 minutes.\n\n6.
    Add the finely chopped bell peppers and let simmer for another 10 minutes.\n\n7.
    Add the kidney beans and spice up the stew with Tabasco or other chili based
    spices.\n\n8. Let it sit for another 5 minutes and then serve with cr\xE8me fra\xEEche
    or sour cream.\n"
