  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b> Potato pancakes</b>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<b>Ingredients:</b>\n\n-
    2 big potatoes\n- Half of an onion\n- 1 egg\n- Seasonings to preference \n- 2-4
    tablespoons of all purpose flour \n- Vegetable oil to fry the pancakes \n\n<b>Instructions:</b>\n\n1. 
    Grate potatoes and onion into a bowl, drain off excess liquid.\n\n2. Add the
    egg, seasonings and flour to the bowl and mix, you should have a thick mixture.\n\n3.
    Heat up a frying pan to a medium heat, add just enough oil to fill the bottom
    of the pan.\n\n4. When the pan is warm, add 2-3 scoops of the batter, press them
    down so they are flat.\n\n5. Fry until golden brown on both sides.\nServe warm,
    with sour cream if you choose to."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
  m_fontMaterials: []
