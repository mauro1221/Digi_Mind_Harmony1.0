  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Stuffed Zucchini</b>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<b>Ingredients:
    (for 2 servings)</b>\n\n- Zucchini \u2013 1 piece\n- Ground meat (of choice)
    \u2013 100 g\n- Olive oil \u2013 0.5 tbsp\n- Onion \u2013 \xBC piece\n- Garlic
    \u2013 \xBE clove\n- Grated cheese \u2013 75 g\n- Provence herbs \u2013 0.13
    tsp\n- Salt \u2013 0.13 tbsp\n- Five pepper mix \u2013 \xBC tbsp\n- Tomato sauce
    \u2013 75 g\n\n<b>Instructions:</b>\n\n1. Preheat the oven to 200 \xB0C (390
    \xB0F).\n\n2. Cut the zucchini in half, remove the seeds and some of the flesh
    to create a hollow.\n\n3. Saut\xE8 the ground meat in olive oil with chopped
    onions and garlic.\n\n4. Add the herbs and cook for a couple of minutes.\n\n5.
    Stir in the tomato sauce and simmer for another 3 minutes.\n\n6. Fill the zucchini
    with the meat mixture and sprinkle with cheese.\n\n7. Bake for about 20 minutes,
    until the cheese has melted and turned golden, and the zucchini are slightly
    tender.\n\n8. For a heartier meal, you can add cooked rice to the meat mixture,
    reducing the amount of meat accordingly\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
